{
  "redirects": [
    {
      "source": "/novel.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "chandni-raat"
        }
      ],
      "destination": "/novel/chandni-raat",
      "permanent": true
    },
    {
      "source": "/novel",
      "destination": "/library.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/novel/:slug",
      "destination": "/novel.html"
    }
  ]
}
